{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-vane.local/contracts/artifact-v1.schema.json",
  "type": "object",
  "required": ["schema_version", "artifact_id", "scope_id", "created_at", "recipe_hash", "package", "sources", "outputs"],
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "minLength": 1},
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"}
  },
  "properties": {
    "schema_version": {"const": "vane-artifact/v1"},
    "artifact_id": {"$ref": "#/$defs/uuid"}, "scope_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$"},
    "recipe_hash": {"$ref": "#/$defs/sha"},
    "package": {"type": "object", "required": ["id", "version", "digest"], "properties": {
      "id": {"type": "string"}, "version": {"type": "string"}, "digest": {"$ref": "#/$defs/sha"}
    }},
    "sources": {"type": "array", "items": {"type": "object", "required": ["asset_id", "sha256", "media_type", "original_name", "path"], "properties": {
      "asset_id": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha"}, "media_type": {"type": "string"}, "original_name": {"type": "string"}, "path": {"$ref": "#/$defs/path"}
    }}},
    "outputs": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name", "kind", "format", "path", "sha256"], "properties": {
      "name": {"type": "string", "minLength": 1}, "kind": {"enum": ["document", "table", "evidence", "image"]},
      "format": {"type": "string"}, "path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/sha"}, "rows": {"type": "integer", "minimum": 0}
    }}}
  }
}
